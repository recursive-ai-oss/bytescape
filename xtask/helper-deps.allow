# Crates the elevated helper may depend on (normal dependencies, all four
# release targets, direct and indirect). `cargo xtask helper-deps` fails when
# the helper's dependency closure contains anything not listed here.
#
# The helper runs with administrator rights and reads untrusted disk data, so
# every new entry needs a maintainer's explicit approval. One crate name per
# line; text after `#` is a comment.

# Workspace crates the helper is designed to use.
bs-tree
bs-scan
bs-scan-ntfs
bs-scan-ext4
bs-scan-btrfs
bs-scan-xfs
bs-ipc
bs-fsops      # open, measure and delete without following links: the one place deletes happen
bs-knowledge  # the protected-path table that every delete is judged against

# Operating system bindings. Nothing else: the helper has no other dependency.
libc          # Linux: openat, unlinkat, statx, prctl, close_range, getppid, fstat
windows-sys   # Windows: handle-based file calls, the named pipe, process checks
windows-link  # pulled in by windows-sys
